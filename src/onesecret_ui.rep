class OnesecretUi
{
    // --- sender ---
    SLOT(void createSecret(QString name, QString body, int ttlHours, QString passphrase, int maxReads))
    SLOT(void burnSecret(QString id))
    SLOT(void forgetSecret(QString id))
    SLOT(void clearLastLink())

    // --- recipient ---
    SLOT(void openLink(QString link, QString passphrase))
    SLOT(void cancelOpen(QString id))

    // --- settings / diagnostics ---
    SLOT(void choosePreset(QString preset))
    SLOT(void copyText(QString text))
    SLOT(void refreshStatus())

    PROP(QString sentList="[]" READONLY)
    PROP(QString pendingList="[]" READONLY)
    PROP(QString lastLink="" READONLY)
    PROP(QString lastLinkId="" READONLY)
    PROP(QString openState="idle" READONLY)
    PROP(QString openInfo="" READONLY)
    PROP(QString openId="" READONLY)
    PROP(QString deliveryState="starting" READONLY)
    PROP(QString deliveryInfo="" READONLY)
    PROP(QString preset="logos.dev" READONLY)
    PROP(QString dataDir="" READONLY)
    PROP(QString lastError="" READONLY)
    PROP(bool clipboardAvailable=false READONLY)

    SIGNAL(secretRevealed(QString id, QString name, QString body))
    SIGNAL(linkCreated(QString id, QString link))
}
